# Nginx: reverse proxy to Streamlit with WebSocket support.
#
# TEMPLATE: the nginx image renders this to /etc/nginx/nginx.conf at container start
# (envsubst, NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx). Only STREAMLIT_UPSTREAM_SERVERS is
# substituted — nginx's own $host / $remote_addr / $1 are lowercase and stay intact.
# Do not edit the rendered file inside the container; edit this template and recreate
# nginx (any deploy script does that for you).
#
# Replica count comes from EVAL_COMPOSE_STREAMLIT_REPLICAS in .env, which drives both
# the compose profiles and this upstream list (deploy/_compose_lib.sh) so they cannot
# disagree. Pointing nginx at a dead upstream yields 502, and every replica costs a
# full copy of the app's caches in RAM — 1 is the right default on a small host.
events {
    worker_connections 2048;
}

http {
    # Docker's embedded DNS. Used by the /bbox-* locations below, which resolve their
    # upstream per request (variable in proxy_pass) and so survive a streamlit1 recreate.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream streamlit_pool {
        # ip_hash = sticky sessions, which Streamlit requires: session state lives in the
        # process holding the WebSocket, and /media/... plus /_stcore/upload_file are served
        # from that same process. Round-robin would break images, downloads and uploads.
        ip_hash;
        # Rendered from STREAMLIT_UPSTREAM_SERVERS: one "server streamlitN:8501;" per replica.
        ${STREAMLIT_UPSTREAM_SERVERS}
    }

    server {
        listen 80;
        server_name _;

        client_max_body_size 200m;

        location /bbox-viewer/ {
            set $bbox_api_upstream streamlit1:8765;
            rewrite ^/bbox-viewer/?(.*)$ /viewer/$1 break;
            proxy_pass http://$bbox_api_upstream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location /bbox-explorer/ {
            set $bbox_api_upstream streamlit1:8765;
            rewrite ^/bbox-explorer/?(.*)$ /explorer/$1 break;
            proxy_pass http://$bbox_api_upstream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location /tlr-viewer/ {
            set $bbox_api_upstream streamlit1:8765;
            rewrite ^/tlr-viewer/?(.*)$ /tlr/$1 break;
            proxy_pass http://$bbox_api_upstream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location /bbox-api/ {
            set $bbox_api_upstream streamlit1:8765;
            rewrite ^/bbox-api(/.*)$ $1 break;
            proxy_pass http://$bbox_api_upstream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location / {
            proxy_pass http://streamlit_pool;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_connect_timeout 60s;
            proxy_send_timeout 86400;
            proxy_read_timeout 86400;
            # Large Streamlit responses / occasional upstream quirks
            proxy_buffer_size 128k;
            proxy_buffers 8 256k;
        }
    }
}
