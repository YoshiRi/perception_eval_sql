# Production deployment: copy to .env and set values.
# Used by docker-compose and optionally by Streamlit/worker at runtime.

# Data root for evaluation runs (must be a path visible inside containers)
EVAL_DASHBOARD_DATA_ROOT=/app/data

# Local evaluator debug: host path that is mounted as /app/data in streamlit/worker.
# Default in docker-compose.yml is ${PWD}/../data when compose is run from deploy/.
# Set this explicitly on deployments that launch compose from another directory.
# This path is also mounted into the worker at the same absolute path so host Docker
# bind mounts created by webauto can see temporary/work directories.
# LOCAL_EVALUATOR_HOST_DATA_ROOT=/absolute/path/to/evaluation_dashboard_app/data

# Local evaluator debug: WebAuto CLI on host and inside the worker container.
# LOCAL_EVALUATOR_WEBAUTO_BIN_HOST=/usr/local/bin/webauto
# LOCAL_EVALUATOR_WEBAUTO_BIN=/usr/local/bin/webauto

# Local evaluator debug: host WebAuto config/cache/data root.
# Mounted at both /root/.webauto and the same absolute host path so WebAuto and
# host Docker can reuse downloaded simulation datasets across runs.
# LOCAL_EVALUATOR_HOST_WEBAUTO_ROOT=/absolute/path/to/.webauto

# Local evaluator debug: comma-separated Docker image prefixes shown in the test image selector.
# LOCAL_EVALUATOR_IMAGE_PREFIXES=firmware.ci.web.auto/,pilot-auto

# Task queue: set to true to use Redis + Worker + Postgres
USE_TASK_QUEUE=true

# Postgres (task metadata). Match POSTGRES_* for the postgres service.
POSTGRES_USER=eval_user
POSTGRES_PASSWORD=eval_pass
POSTGRES_DB=eval_dashboard
DATABASE_URL=postgresql://eval_user:eval_pass@postgres:5432/eval_dashboard

# Redis (task queue)
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=default

# T4 visualizer server base URL used by Bounding Box Viewer / T4 pages
# In Docker, set to a host-reachable endpoint (compose maps host.docker.internal)
T4_VISUALIZER_BASE_URL=http://host.docker.internal:8000
# Browser-facing iframe/link URL for direct (localhost/IP) access.
#T4_VISUALIZER_BROWSER_BASE_URL=http://localhost:8000
# Browser-facing URL used ONLY when the dashboard is reached through Cloudflare
# (auto-detected from Cf-* request headers). Set to the dataset server's public
# Cloudflare hostname; leave unset to always use the direct URL above.
# Keep the real hostname OUT of the repo: put it in the untracked deploy/.env.local.
#T4_VISUALIZER_CLOUDFLARE_BASE_URL=https://<dataset-server-cloudflare-host>
# Optional: Cloudflare Access service token for Streamlit's server-side T4 API calls
# when T4_VISUALIZER_BASE_URL itself is protected by Cloudflare Access.
#T4_VISUALIZER_CF_ACCESS_CLIENT_ID=<cloudflare-access-service-token-client-id>
#T4_VISUALIZER_CF_ACCESS_CLIENT_SECRET=<cloudflare-access-service-token-client-secret>

# Docker Compose: default worker replica count (04_START.sh / 08_REBUILD_AND_START.sh). Streamlit defaults to streamlit1 only; optional second app server: compose --profile ha (see docker-compose.yml + nginx.conf).
EVAL_COMPOSE_SCALE_WORKER=2

# Same secret on both Streamlit containers (session cookies / multi-replica). Compose sets a dev default; override in production: openssl rand -hex 32
# STREAMLIT_SERVER_COOKIE_SECRET=

# Detection Stats page: stderr timing logs + debug expander (docker compose logs streamlit1)
# EVAL_DETECTION_STATS_DEBUG=1

# RQ: max job runtime before the worker kills the job (seconds). Default 7 days if unset.
# RQ_JOB_TIMEOUT_SEC=604800
# Optional: longer timeout for build_parquet only (defaults to RQ_JOB_TIMEOUT_SEC if unset)
# RQ_BUILD_PARQUET_TIMEOUT_SEC=604800

# Optional: per-user task visibility (company auth / WebAutoAuth)
# Header name set by auth proxy with current user id (e.g. X-Forwarded-User)
# AUTH_USER_HEADER=X-Forwarded-User
# Dev fallback when no proxy: AUTH_DEFAULT_USER=dev@example.com

# Optional: Nginx only exposes 80; set for TLS in production
# NGINX_HTTPS=1

# Git SSH key for private-repo access (mounted as the compose `ssh` secret).
# Defaults to the invoking user's ~/.ssh/id_rsa; set this on hosts where the key
# lives elsewhere (e.g. a service account / deploy key).
# SSH_PRIVATE_KEY_FILE=/home/deploy/.ssh/id_rsa

# Optional: filter containers on Deployment debug page (see PRODUCTION_DEPLOYMENT.md)
# EVAL_DEPLOYMENT_DEBUG_COMPOSE_PROJECT=myproject
# Optional: allow "Run command" (docker exec) on that page — high risk; default 0 in compose
# EVAL_DEPLOYMENT_DEBUG_EXEC=1

# ---------------------------------------------------------------------------
# Local desktop client (evaldash-local) -- see client/README.md
# ---------------------------------------------------------------------------
# Bearer token that enables the export routes (/api/runs, /api/export_manifest,
# /api/export_file, /api/export_prebake) so a local client can download generated
# result files. These routes are CLOSED while this is unset: they stream raw file
# bytes, unlike the rest of the bbox API which only returns aggregates. Use a long
# random value and treat it as a secret.
# EVAL_EXPORT_TOKEN=change-me-to-a-long-random-string

# Evaluator library paths used to unpickle scene_result.pkl, os.pathsep-separated.
# Only needed for pre-baking and for the exact pickle-backed DevOps routes. When unset,
# the developer-machine defaults are tried and the routes degrade to available:false.
# EVAL_LIB_PATHS=/opt/driving_log_replayer_v2:/opt/autoware_perception_evaluation/perception_eval

# Set to 0 to ignore pre-baked answers under <run>/<role>/.export_prebake/ and always
# recompute from scene_result.pkl. Useful when regenerating or comparing.
# EVAL_PREBAKE_READ=0

# Where derived DuckDB caches are written. Defaults to <app_root>/.cache.
# EVAL_BBOX_CACHE_DIR=/app/.cache
